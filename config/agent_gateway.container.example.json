{
  "_comment": "Container-oriented Gateway config. Paths are resolved inside the runtime image under /app.",
  "logging": {
    "log_dir": "/app/logs/agent_gateway",
    "logger_name": "agent_gateway_server",
    "file_name": "agent_gateway_server.log",
    "enable_console": true,
    "use_daily_rotation": true,
    "max_file_size_bytes": 10485760,
    "max_files": 7
  },
  "persona_gateway": {
    "address": "0.0.0.0",
    "port": 8080,
    "http_io_threads": 2,
    "websocket_path": "/ws/session",
    "session_idle_timeout_minutes": 15,
    "session_max_recent_turns": 20,
    "session_max_active_sessions": 1024,
    "runtime_recent_raw_turns": 10,
    "runtime_max_prompt_characters": 131072,
    "runtime_default_model": "deepseek-chat",
    "compute_pool": {
      "worker_count": 4,
      "queue_capacity": 512
    },
    "io_pool": {
      "worker_count": 8,
      "queue_capacity": 1024
    },
    "llm_pool": {
      "worker_count": 8,
      "queue_capacity": 1024,
      "scheduler": "session_affinity"
    },
    "request_filter": {
      "enabled": true,
      "reject_control_chars": true,
      "reject_suspicious_patterns": true
    },
    "static_files": {
      "enabled": true,
      "root": "/app/dist",
      "index_file": "index.html",
      "spa_fallback": true
    }
  },
  "gateway_auth": {
    "enabled": true,
    "allow_dev_identity": false,
    "require_auth_for_api": true,
    "cookie_name": "agent_auth",
    "issuer": "agent-gateway",
    "audience": "agent-gateway",
    "clock_skew_seconds": 60,
    "token_ttl_seconds": 28800,
    "cookie_http_only": true,
    "cookie_secure": false,
    "cookie_same_site": "Lax",
    "require_session_record": false,
    "auto_provision_session": true,
    "session_store_backend": "sqlite",
    "session_database_path": "/app/data/agent_gateway/auth_sessions.db",
    "redis_host": "redis",
    "redis_port": "6379",
    "redis_pool_size": 16,
    "redis_command_timeout_ms": 5000,
    "redis_key_prefix": "agent:gateway:auth",
    "generate_dev_keys": true
  },
  "llm": {
    "enabled": true,
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "AGENT_LLM_API_KEY",
    "api_key_file": "",
    "model": "deepseek-chat",
    "timeout_ms": 30000,
    "max_retries": 2,
    "async_http_io_threads": 4,
    "http_keep_alive": true,
    "http_max_idle_connections": 128,
    "http_max_idle_connections_per_origin": 64,
    "http_idle_timeout_ms": 30000,
    "require_api_key": true,
    "allow_placeholder": false,
    "disable_tls_verify_on_windows": false
  },
  "local_llm": {
    "enabled": false,
    "target": "multimodal-inference:50051",
    "deadline_ms": 30000,
    "auth_token": "",
    "auth_metadata_key": "authorization"
  },
  "embedding": {
    "tokenizer_path": "/app/onnx_models/minilm/tokenizer.json",
    "model_path": "/app/onnx_models/minilm/model.onnx",
    "dimension": 384,
    "execution_provider": "auto",
    "batch_enabled": true,
    "batch_max_pending_requests": 1024,
    "batch_max_size": 16,
    "batch_max_wait_ms": 2,
    "batch_max_inflight": 1
  },
  "emotion_analyzer": {
    "enabled": true,
    "backend": "grpc",
    "target": "emotion-inference:50052",
    "tokenizer_path": "/app/onnx_models/joint/tokenizer.json",
    "deadline_ms": 3000,
    "auth_token": "",
    "auth_metadata_key": "authorization",
    "max_length": 96,
    "truncation": true,
    "padding": true,
    "add_special_tokens": true
  },
  "emotion_fusion": {
    "enabled": true,
    "bert_weight": 1.0,
    "default_reliability": 0.7,
    "accept_confidence": 0.55,
    "ambiguity_margin": 0.12,
    "head_bias": 0.0,
    "bert_signal_weight": 2.0,
    "evidence_signal_weight": 2.2,
    "margin_signal_weight": 0.5,
    "source_weights": {
      "keyword": 0.75,
      "vector": 0.85,
      "llm": 0.9
    }
  },
  "l0_memory": {
    "enabled": true,
    "redis_host": "redis",
    "redis_port": 6379,
    "sqlite_path": "/app/data/agent_gateway/l0_memory.db",
    "max_cached_records": 1000,
    "top_k": 5,
    "candidate_multiplier": 4,
    "neighbors_per_hit": 1,
    "similarity_floor": 0.78,
    "warm_window_seconds": 3600,
    "half_life_seconds": 172800,
    "max_age_seconds": 604800,
    "max_payload_bytes": 65536,
    "user_uuid": "gateway-l0"
  },
  "document_store": {
    "enabled": true,
    "root": "/app/data/agent_gateway/documents",
    "database_path": "/app/data/agent_gateway/document_store.db",
    "read_connection_count": 2,
    "write_connection_count": 1,
    "busy_timeout_ms": 5000,
    "retention_hours": 168,
    "cleanup_interval_seconds": 60
  },
  "document_llm_chunk_cache": {
    "enabled": true,
    "redis_host": "redis",
    "redis_port": 6379,
    "redis_pool_size": 4,
    "key_prefix": "agent:gateway:document:llm_chunk",
    "ttl_seconds": 604800
  },
  "document_semantic_cache": {
    "enabled": true,
    "redis_host": "redis",
    "redis_port": 6379,
    "sqlite_path": "/app/data/agent_gateway/document_semantic_cache.db",
    "user_uuid": "document-semantic-cache",
    "max_cached_records": 10000,
    "top_k": 6,
    "similarity_floor": 0.94
  },
  "l3_memory": {
    "enabled": true,
    "sqlite_path": "/app/data/agent_gateway/l3_memory.db",
    "registry_sqlite_path": "/app/data/agent_gateway/l3_registry.db",
    "collection_name": "l3_memory",
    "embedding_fingerprint": "minilm-l6-v2",
    "tokenizer_fingerprint": "minilm-l6-v2",
    "corpus_version": "v1",
    "policy_version": "v1",
    "index_backend": "exact",
    "max_resident_partitions": 16,
    "max_records_per_batch": 1000,
    "compression_max_tokens": 800,
    "compression_temperature": 0.1,
    "user_uuids": [
      "gateway-l0"
    ]
  },
  "l3_flush_scheduler": {
    "enabled": true,
    "check_interval_seconds": 300,
    "flush_hour": 3,
    "flush_minute": 0,
    "flush_date_offset_days": 0,
    "defer_when_sessions_active": true
  }
}
