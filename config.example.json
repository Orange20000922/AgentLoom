{
  "_comment": "Production-style config for agent_gateway_server. Paths are resolved relative to this file.",
  "logging": {
    "log_dir": "logs/agent_gateway",
    "logger_name": "agent_gateway_server",
    "file_name": "agent_gateway_server.log",
    "enable_console": true,
    "use_daily_rotation": true,
    "max_file_size_bytes": 10485760,
    "max_files": 7
  },
  "persona_gateway": {
    "address": "127.0.0.1",
    "port": 18080,
    "http_io_threads": 2,
    "websocket_path": "/ws/session",
    "session_idle_timeout_minutes": 15,
    "session_max_recent_turns": 20,
    "session_max_active_sessions": 1024,
    "runtime_recent_raw_turns": 10,
    "runtime_default_model": "deepseek-chat",
    "compute_pool": {
      "worker_count": 4,
      "queue_capacity": 512,
      "scheduler": "session_affinity",
      "max_active_keys": 1024,
      "max_outstanding_per_key": 8,
      "max_outstanding_per_fairness_key": 32,
      "max_outstanding_per_tenant": 256
    },
    "io_pool": {
      "worker_count": 8,
      "queue_capacity": 1024,
      "scheduler": "session_affinity",
      "max_active_keys": 1024,
      "max_outstanding_per_key": 16,
      "max_outstanding_per_fairness_key": 64,
      "max_outstanding_per_tenant": 512
    },
    "llm_pool": {
      "worker_count": 8,
      "queue_capacity": 1024,
      "scheduler": "session_affinity",
      "max_active_keys": 1024,
      "max_outstanding_per_key": 16,
      "max_outstanding_per_fairness_key": 64,
      "max_outstanding_per_tenant": 512
    },
    "request_filter": {
      "enabled": true,
      "reject_control_chars": true,
      "reject_suspicious_patterns": true
    },
    "static_files": {
      "enabled": true,
      "root": "dist",
      "index_file": "index.html",
      "spa_fallback": true
    }
  },
  "gateway_auth": {
    "enabled": true,
    "allow_dev_identity": false,
    "require_auth_for_api": true,
    "cookie_name": "agent_auth",
    "issuer": "agent-gateway",
    "audience": "agent-gateway",
    "clock_skew_seconds": 60,
    "token_ttl_seconds": 28800,
    "cookie_http_only": true,
    "cookie_secure": false,
    "cookie_same_site": "Lax",
    "require_session_record": false,
    "auto_provision_session": true,
    "session_store_backend": "sqlite",
    "session_database_path": "data/agent_gateway/auth_sessions.db",
    "redis_host": "127.0.0.1",
    "redis_port": "5000",
    "redis_pool_size": 16,
    "redis_command_timeout_ms": 5000,
    "redis_key_prefix": "agent:gateway:auth",
    "generate_dev_keys": true
  },
  "llm": {
    "enabled": true,
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "AGENT_LLM_API_KEY",
    "api_key_file": "",
    "model": "deepseek-chat",
    "timeout_ms": 30000,
    "max_retries": 2,
    "async_http_io_threads": 4,
    "http_keep_alive": true,
    "http_max_idle_connections": 128,
    "http_max_idle_connections_per_origin": 64,
    "http_idle_timeout_ms": 30000,
    "response_validation": {
      "token_count_mode": "off",
      "tokenizer_path": "",
      "tokenizer_model": "deepseek-chat",
      "max_token_difference": 2
    },
    "require_api_key": true,
    "allow_placeholder": false,
    "disable_tls_verify_on_windows": false,
    "ca_bundle_path": "config/certs/mozilla-ca-bundle.pem"
  },
  "skills": {
    "enabled": true,
    "manifest_directory": "skills",
    "manifest_filename_regex": ".*skill.*\\.json$",
    "manifests": [],
    "tool_memory_sqlite_path": "data/skill_l4.sqlite",
    "tool_memory_collection_name": "skill_l4",
    "tool_memory_top_k": 3,
    "tool_memory_min_score": 0.78
  },
  "local_llm": {
    "enabled": false,
    "target": "127.0.0.1:50051",
    "deadline_ms": 30000,
    "auth_token": "",
    "auth_metadata_key": "authorization"
  },
  "embedding": {
    "tokenizer_path": "onnx_models/minilm/tokenizer.json",
    "model_path": "onnx_models/minilm/model.onnx",
    "dimension": 384,
    "execution_provider": "auto",
    "batch_enabled": true,
    "batch_max_pending_requests": 1024,
    "batch_max_size": 16,
    "batch_max_wait_ms": 2,
    "batch_max_inflight": 1
  },
  "emotion_analyzer": {
    "enabled": true,
    "backend": "grpc",
    "target": "127.0.0.1:50051",
    "tokenizer_path": "onnx_models/joint/tokenizer.json",
    "deadline_ms": 3000,
    "auth_token": "",
    "auth_metadata_key": "authorization",
    "max_length": 96,
    "truncation": true,
    "padding": true,
    "add_special_tokens": true
  },
  "emotion_fusion": {
    "enabled": true,
    "bert_weight": 1.0,
    "default_reliability": 0.7,
    "accept_confidence": 0.55,
    "ambiguity_margin": 0.12,
    "head_bias": 0.0,
    "bert_signal_weight": 2.0,
    "evidence_signal_weight": 2.2,
    "margin_signal_weight": 0.5,
    "source_weights": {
      "keyword": 0.75,
      "vector": 0.85,
      "llm": 0.9
    },
    "label_reliability": {
      "joy": 0.78,
      "sadness": 0.72,
      "anger": 0.69,
      "fear": 0.64,
      "surprise": 0.58,
      "disgust": 0.52,
      "neutral": 0.82,
      "excitement": 0.74,
      "tenderness": 0.70,
      "curiosity": 0.76
    },
    "keyword_rules": {
      "sadness": [
        {
          "pattern": "考砸|学不会|没希望",
          "score": 0.95
        }
      ],
      "curiosity": [
        "为什么|怎么来的|能不能再讲"
      ]
    }
  },
  "emotion": {
    "generation": {
      "max_tokens": 2048,
      "min_tokens": 100,
      "max_token_ratio": 1.25,
      "default_token_weight": 1.0,
      "high_intensity_threshold": 0.7,
      "high_intensity_multiplier": 1.1,
      "token_weights": {
        "neutral": 1.0,
        "joy": 1.0,
        "excitement": 1.05,
        "sadness": 1.1,
        "fear": 1.1,
        "anger": 1.05,
        "disgust": 1.0,
        "surprise": 1.05,
        "tenderness": 1.05,
        "curiosity": 1.15
      }
    }
  },
  "l0_memory": {
    "enabled": true,
    "redis_host": "127.0.0.1",
    "redis_port": 5000,
    "sqlite_path": "data/agent_gateway/l0_memory.db",
    "max_cached_records": 1000,
    "top_k": 5,
    "candidate_multiplier": 4,
    "neighbors_per_hit": 1,
    "similarity_floor": 0.78,
    "warm_window_seconds": 3600,
    "half_life_seconds": 172800,
    "max_age_seconds": 604800,
    "user_uuid": "gateway-l0"
  },
  "document_store": {
    "enabled": true,
    "root": "data/agent_gateway/documents",
    "database_path": "data/agent_gateway/document_store.db",
    "read_connection_count": 2,
    "write_connection_count": 1,
    "busy_timeout_ms": 5000,
    "retention_hours": 168,
    "cleanup_interval_seconds": 60
  },
  "document_llm_chunk_cache": {
    "enabled": true,
    "redis_host": "127.0.0.1",
    "redis_port": 5000,
    "redis_pool_size": 4,
    "key_prefix": "agent:gateway:document:llm_chunk",
    "ttl_seconds": 604800
  },
  "document_semantic_cache": {
    "enabled": true,
    "redis_host": "127.0.0.1",
    "redis_port": 5000,
    "sqlite_path": "data/agent_gateway/document_semantic_cache.db",
    "user_uuid": "document-semantic-cache",
    "max_cached_records": 10000,
    "top_k": 6,
    "similarity_floor": 0.94
  },
  "l3_memory": {
    "enabled": true,
    "sqlite_path": "data/agent_gateway/l3_memory.db",
    "registry_sqlite_path": "data/agent_gateway/l3_registry.db",
    "collection_name": "l3_memory",
    "embedding_fingerprint": "minilm-l6-v2",
    "tokenizer_fingerprint": "minilm-l6-v2",
    "corpus_version": "v1",
    "policy_version": "v1",
    "index_backend": "exact",
    "max_resident_partitions": 16,
    "max_records_per_batch": 1000,
    "compression_max_tokens": 800,
    "compression_temperature": 0.1,
    "user_uuids": [
      "gateway-l0"
    ]
  },
  "l3_flush_scheduler": {
    "enabled": true,
    "check_interval_seconds": 300,
    "flush_hour": 3,
    "flush_minute": 0,
    "flush_date_offset_days": 0,
    "defer_when_sessions_active": true
  }
}
