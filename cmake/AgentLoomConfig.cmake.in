@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Protobuf CONFIG)
find_dependency(gRPC CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(OpenSSL)
find_dependency(nlohmann_json CONFIG)
find_dependency(Boost @AGENTLOOM_BOOST_VERSION_STRING@ EXACT)
find_dependency(hiredis CONFIG)
find_dependency(redis++ CONFIG)
if(NOT TARGET redis++::redis++)
    if(TARGET redis++::redis++_static)
        add_library(redis++::redis++ ALIAS redis++::redis++_static)
    else()
        message(FATAL_ERROR
            "redis-plus-plus did not export redis++::redis++ or redis++::redis++_static")
    endif()
endif()
find_dependency(libzip CONFIG)
find_dependency(pugixml CONFIG)
find_dependency(Threads)

set(AgentLoom_THIRD_PARTY_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/AgentLoom/third_party")

if(NOT TARGET faiss)
    add_library(faiss SHARED IMPORTED)
    if(WIN32)
        set_target_properties(faiss PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/faiss.dll"
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/faiss.lib"
            INTERFACE_INCLUDE_DIRECTORIES "${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/faiss")
    else()
        find_library(AgentLoom_OPENBLAS_LIBRARY NAMES openblas libopenblas.so.0 REQUIRED)
        set_target_properties(faiss PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libfaiss.so"
            INTERFACE_INCLUDE_DIRECTORIES "${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/faiss"
            INTERFACE_LINK_LIBRARIES "${AgentLoom_OPENBLAS_LIBRARY}")
    endif()
endif()

if(@AGENTLOOM_PACKAGE_HAS_MEDIA@)
    find_dependency(OpenCV CONFIG COMPONENTS core imgproc videoio)
endif()

set(AgentLoom_ONNXRUNTIME_INCLUDE_DIR "${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/onnxruntime")
set(AgentLoom_SQLITE_INCLUDE_DIR "${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/sqlite")
set(AgentLoom_HF_TOKENIZERS_INCLUDE_DIR "${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/hf_tokenizers")
if(NOT TARGET Boost::headers)
    if(TARGET Boost::boost)
        add_library(Boost::headers INTERFACE IMPORTED)
        set_property(TARGET Boost::headers PROPERTY
            INTERFACE_LINK_LIBRARIES Boost::boost)
    else()
        message(FATAL_ERROR
            "AgentLoom requires a Boost package that provides Boost::headers or Boost::boost")
    endif()
endif()

if(NOT TARGET onnxruntime)
    add_library(onnxruntime SHARED IMPORTED)
    if(WIN32)
        set_target_properties(onnxruntime PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/onnxruntime.dll"
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/onnxruntime.lib"
            INTERFACE_INCLUDE_DIRECTORIES "${AgentLoom_ONNXRUNTIME_INCLUDE_DIR}")
    else()
        set_target_properties(onnxruntime PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libonnxruntime.so"
            INTERFACE_INCLUDE_DIRECTORIES "${AgentLoom_ONNXRUNTIME_INCLUDE_DIR}")
    endif()
endif()

if(WIN32 AND NOT TARGET sqlite3)
    add_library(sqlite3 SHARED IMPORTED)
    set_target_properties(sqlite3 PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/sqlite3.dll"
        INTERFACE_INCLUDE_DIRECTORIES "${AgentLoom_SQLITE_INCLUDE_DIR}")
    set_property(TARGET sqlite3 PROPERTY
        IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/sqlite3.lib")
endif()

if(NOT TARGET hf_tokenizers_capi)
    add_library(hf_tokenizers_capi STATIC IMPORTED)
    set_target_properties(hf_tokenizers_capi PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@HF_TOKENIZERS_STATICLIB_NAME@"
        INTERFACE_INCLUDE_DIRECTORIES "${AgentLoom_HF_TOKENIZERS_INCLUDE_DIR}")
    if(WIN32)
        set_property(TARGET hf_tokenizers_capi APPEND PROPERTY INTERFACE_LINK_LIBRARIES
            ws2_32 userenv advapi32 bcrypt ntdll kernel32 ole32 oleaut32 uuid synchronization)
    elseif(APPLE)
        set_property(TARGET hf_tokenizers_capi APPEND PROPERTY INTERFACE_LINK_LIBRARIES
            "-framework Security" "-framework CoreFoundation")
    else()
        set_property(TARGET hf_tokenizers_capi APPEND PROPERTY INTERFACE_LINK_LIBRARIES pthread dl m)
    endif()
endif()

if(@AGENTLOOM_BUILD_LOCAL_LLM@ AND NOT TARGET AgentLoom::llama_cpp_external)
    add_library(AgentLoom::llama_cpp_external INTERFACE IMPORTED)
    set(_agentloom_llama_libraries "")
    foreach(_agentloom_llama_library_name IN ITEMS @AGENTLOOM_LLAMA_LIBRARY_NAMES@)
        list(APPEND _agentloom_llama_libraries
            "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/${_agentloom_llama_library_name}")
    endforeach()
    set_target_properties(AgentLoom::llama_cpp_external PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES
            "${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/llama_cpp/include;${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/llama_cpp/mtmd;${AgentLoom_THIRD_PARTY_INCLUDE_DIR}/llama_cpp/common"
        INTERFACE_LINK_LIBRARIES "${_agentloom_llama_libraries}")
endif()

if(@AGENTLOOM_PACKAGE_HAS_GSTREAMER@ AND WIN32 AND NOT TARGET AgentLoom::gstreamer_external)
    set(AgentLoom_GSTREAMER_ROOT "" CACHE PATH "GStreamer MSVC x64 SDK root")
    if(NOT AgentLoom_GSTREAMER_ROOT)
        message(FATAL_ERROR
            "This AgentLoom package includes GStreamer media targets. Set AgentLoom_GSTREAMER_ROOT "
            "to the GStreamer MSVC x64 SDK root, or consume a package built with AGENTLOOM_BUILD_MEDIA=OFF.")
    endif()
    add_library(AgentLoom::gstreamer_external INTERFACE IMPORTED)
    set_target_properties(AgentLoom::gstreamer_external PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES
            "${AgentLoom_GSTREAMER_ROOT}/include/gstreamer-1.0;${AgentLoom_GSTREAMER_ROOT}/include/glib-2.0;${AgentLoom_GSTREAMER_ROOT}/lib/glib-2.0/include"
        INTERFACE_LINK_LIBRARIES
            "${AgentLoom_GSTREAMER_ROOT}/lib/gstreamer-1.0.lib;${AgentLoom_GSTREAMER_ROOT}/lib/gobject-2.0.lib;${AgentLoom_GSTREAMER_ROOT}/lib/glib-2.0.lib;${AgentLoom_GSTREAMER_ROOT}/lib/gstapp-1.0.lib;${AgentLoom_GSTREAMER_ROOT}/lib/gstvideo-1.0.lib;${AgentLoom_GSTREAMER_ROOT}/lib/gstsdp-1.0.lib;${AgentLoom_GSTREAMER_ROOT}/lib/gstwebrtc-1.0.lib")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AgentLoomTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/AgentLoomWholeArchive.cmake")

check_required_components(AgentLoom)
